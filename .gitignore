# Build output
bin/
obj/
*.user
*.suo

# NuGet
packages/
*.nupkg
project.lock.json

# Strong-name keys: NOT ignored on purpose. demo-solution/plugins/DVerse.Plugins/
# DVerse.Plugins.snk is committed because Dataverse sandbox registration requires a
# strong-named assembly and a fresh clone must build; it is assembly identity for a
# demo plugin, not a secret (see the csproj comment). Don't add *.snk here.

# VS
.vs/
*.rsuser

# Solution unpack scratch
**/solution.zip

# OS
Thumbs.db
.DS_Store

# agent worktrees
.worktrees/
# The canvas msapp part is REGENERATED by pac solution pack from the exploded *_DocumentUri/ directory (decompile: CanvasAppsProcessor deletes and re-zips it every pack). The directory is the source; the msapp is a build artifact.
demo-solution/canvasapps/*_DocumentUri.msapp

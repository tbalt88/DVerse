<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net462, SDK-style, per the mission ruling (wave 4.4a). Strong-name
    signing is ON as of wave 4.4b grading: Dataverse refuses to register a
    sandbox PluginAssembly whose identity has no public key token ("Public
    assembly must have public key token", live import error, golden import
    five). The archived seed repo tbalt88/DVerseClaudeSkills had a different
    defect in this area: SignAssembly=true with AssemblyOriginatorKeyFile=
    key.snk while gitignoring *.snk, so a fresh clone could not build the
    plugin project at all. The fix is not to avoid signing (the platform
    demands it) but to COMMIT the snk: it is assembly identity for a demo
    plugin, not a secret, and the build must work from a fresh clone.

    Tests live in a SEPARATE sibling project, DVerse.Plugins.Tests, not
    nested inside this project's folder. The seed nested its Tests/ folder
    under the plugin project folder with no Compile Remove, so the plugin
    project's default recursive glob (**/*.cs) picked up the test sources
    too. Being a sibling directory rather than a subdirectory means the
    default glob here never reaches the test project's files; no exclusion
    element is needed to avoid the defect because the defect cannot occur
    given this layout.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>DVerse.Plugins</AssemblyName>
    <RootNamespace>DVerse.Plugins</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>DVerse.Plugins.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.49" />
  </ItemGroup>

</Project>
